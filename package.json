{
  "name": "obelisk-mcp",
  "version": "0.1.5",
  "description": "The Obelisk CLI and MCP server: comment on a passage of an Obsidian note, and propose suggested edits, from outside the app.",
  "mcpName": "io.github.zachhannum/obelisk",
  "bin": {
    "obelisk": "dist/cli.mjs",
    "obelisk-mcp": "dist/mcp.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachhannum/obelisk.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint --max-warnings 0 .",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "prepublishOnly": "npm run build",
    "shots": "npm run build && playwright test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "version": "node version-bump.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "eslint": "9.37.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "^1.13.1",
    "obsidian-launcher": "^3.2.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.61.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "files": [
    "dist/"
  ]
}
